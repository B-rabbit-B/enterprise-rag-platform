# LLM配置
LLM_API_KEY=your_api_key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# JWT配置
JWT_SECRET_KEY=your_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# ================ 数据库 ================
SQLITE_DATABASE_URL=sqlite:///./rag_app.db

# ================ RAG业务参数（可选，有默认值） ================
# RAG_MAX_CONTEXT_TOKEN=2000
# RAG_RETRIEVE_TOP_K=5
# RAG_RERANK_TOP_N=3

# ================ 混合检索配置（v1.1，可选，有默认值） ================
# HYBRID_ENABLE=true                  # 是否启用混合检索（BM25 + 向量加权融合）
# HYBRID_VECTOR_WEIGHT=0.6            # 向量检索权重
# HYBRID_BM25_WEIGHT=0.4              # BM25 关键词检索权重
# HYBRID_BM25_TOP_K=5                 # BM25 召回数量

# ================ 可选：HuggingFace 国内镜像加速 ================
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_DISABLE_SYMLINKS_WARNING=1